{
  "manifest_version": 3,
  "name": "Wings of Fire Search",
  "version": "1.0.1",
  "description": "A Wings of Fire themed search page for every new tab.",
  "permissions": ["tabs", "storage"],
  "background": {
    "service_worker": "background.js"
  },
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["google-results-background.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["youtube-background.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.roblox.com/*"],
      "js": ["roblox-background.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
      "js": ["chatgpt-background.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/backgrounds/darkstalker.png",
        "assets/backgrounds/sundew.png",
        "assets/backgrounds/cricket.png",
        "assets/backgrounds/blue.png",
        "assets/backgrounds/clearsight.png",
        "assets/fanwing-crest.png"
      ],
      "matches": ["https://www.google.com/*", "https://www.youtube.com/*", "https://www.roblox.com/*", "https://chatgpt.com/*", "https://chat.openai.com/*"]
    }
  ],
  "icons": {
    "16": "assets/fanwing-crest.png",
    "32": "assets/fanwing-crest.png",
    "48": "assets/fanwing-crest.png",
    "128": "assets/fanwing-crest.png"
  }
}
